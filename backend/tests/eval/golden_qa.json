{
  "meta": {
    "corpus": [
      "docs/SPEC.md"
    ],
    "note": "RAG retrieval golden set. expected_snippets must be exact substrings of the corpus so recall@k is deterministic (no LLM). category: lexical = code/ids/spec names where dense vectors fail; semantic = paraphrase queries.",
    "minimum": 30,
    "reference_cases": 15
  },
  "cases": [
    {
      "query": "RagBase 是什么平台",
      "expected_snippets": [
        "RAG 知识库问答平台——上传私有文档构建知识库，基于检索增强生成（RAG）提供带来源引用的问答"
      ],
      "category": "semantic",
      "expected_answer": "RagBase 是 RAG 知识库问答平台，上传私有文档构建知识库，基于检索增强生成提供带来源引用的问答。"
    },
    {
      "query": "上传文档大小限制是多少",
      "expected_snippets": [
        "pdf/txt/md ≤20MB"
      ],
      "category": "lexical",
      "expected_answer": "上传文档大小限制为 20MB。"
    },
    {
      "query": "RAG 向量化用什么模型",
      "expected_snippets": [
        "DashScope text-embedding-v3"
      ],
      "category": "lexical"
    },
    {
      "query": "embedding 向量维度",
      "expected_snippets": [
        "1024 维"
      ],
      "category": "lexical",
      "expected_answer": "embedding 向量维度为 1024。"
    },
    {
      "query": "数据库端口是多少",
      "expected_snippets": [
        "5433"
      ],
      "category": "lexical",
      "expected_answer": "数据库端口是 5433。"
    },
    {
      "query": "数据库用什么版本",
      "expected_snippets": [
        "pgvector/pg16"
      ],
      "category": "lexical"
    },
    {
      "query": "ruff 行长限制",
      "expected_snippets": [
        "line-length=120"
      ],
      "category": "lexical",
      "expected_answer": "ruff 行长为 120。"
    },
    {
      "query": "mypy 用什么模式",
      "expected_snippets": [
        "strict 模式"
      ],
      "category": "lexical"
    },
    {
